# Optional path to a YAML/JSON config file (see config/config.example.yml)
#CONFIG_FILE=/etc/webitel/kb.yml

CONSUL_ADDR=localhost:8500
PUBSUB_URL=amqp://admin:admin@localhost:5672?heartbeat=10
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/webitel?application_name=webitel-kb&sslmode=disable&connect_timeout=10

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# gRPC listen address
SERVICE_ADDR=127.0.0.1:10049

# Enable mTLS; requires CAs, server and client certificates
SERVICE_CONN_VERIFY_CERTS=false

# Required if SERVICE_CONN_VERIFY_CERTS=true
#SERVICE_CONN_CA=
#SERVICE_CONN_CERT=
#SERVICE_CONN_KEY=
#SERVICE_CONN_CLIENT_CA=
#SERVICE_CONN_CLIENT_CERT=
#SERVICE_CONN_CLIENT_KEY=

# Log level: debug, info, warn, error (default: info)
#LOG_LEVEL=info
#LOG_JSON=false
#LOG_OTEL=false
#LOG_CONSOLE=true
#LOG_FILE=

POSTGRES_MAX_OPEN_CONNS=5
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_IDLE_TIME=300s
POSTGRES_CONN_MAX_LIFETIME=300s

PUBSUB_DRIVER=amqp
